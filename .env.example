# Copy to .env and change the values:
#   cp .env.example .env   (Linux/macOS/WSL)
#   copy .env.example .env (Windows cmd / PowerShell)
#
# Shadowsocks encryption method (list: aes-128-gcm, aes-256-gcm,
# chacha20-ietf-poly1305, ...)
SS_METHOD=aes-256-gcm

# Shadowsocks password. Use a long random password.
# IMPORTANT: avoid the special characters $, " and \ - they can break compose interpolation.
SS_PASSWORD=ChangeMe_strong_password

# Port on which ssserver listens in the container (inside the compose network).
# Must match "port = 8388" in config/tunnels.conf.
SS_SERVER_PORT=8388

# SOCKS5 port on the client (published to the host from docker-compose.client.yml).
SS_LOCAL_PORT=1080

# i2pd webconsole password (Basic Auth, http.auth enabled via CLI arg).
# Use a long random password. Same special-character restrictions
# as for SS_PASSWORD: avoid $, " and \.
I2PD_CONSOLE_PASS=ChangeMe_strong_password

# I2P tunnel length (number of hops). Range 0-8, default 3.
# inbound  - inbound tunnel (server i2pd accepts through it);
# outbound - outbound tunnel (client i2pd connects through it).
# Full client->server path = I2P_OUTBOUND_LENGTH + I2P_INBOUND_LENGTH (default 3+3=6).
# Fewer hops = faster, but less anonymity; deviating from the network default of 3
# makes your traffic stand out from the rest of the network.
I2P_INBOUND_LENGTH=3
I2P_OUTBOUND_LENGTH=3

# Docker image tags
I2PD_IMAGE_TAG=release-2.61.0
SS_IMAGE_TAG=v1.25.0